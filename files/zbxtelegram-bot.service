[Unit]
Description=Zabbix Telegram Bot
After=network.target

[Service]
Type=simple
User=zabbix
Group=zabbix
ExecStart=/usr/lib/zabbix/alertscripts/venv/bin/python /usr/lib/zabbix/alertscripts/zbxTelegramBot.py
Restart=always
RestartSec=5
Environment=PYTHONPATH=/usr/lib/zabbix/alertscripts/venv/lib/python3.8/site-packages
WorkingDirectory=/usr/lib/zabbix/alertscripts

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/zabbix /var/cache/zabbix
ReadOnlyPaths=/

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zbxtelegram-bot

[Install]
WantedBy=multi-user.target