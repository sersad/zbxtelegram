from io import StringIO
from urllib.error import HTTPError, URLError
from urllib.parse import quote_plus as urllib_quote_plus
from urllib.request import Request, urlopen

# Import configuration
try:
    from zbxTelegram_config import *
except ImportError:
    # Fallback to default configuration if import fails
    tg_token = os.environ.get('TELEGRAM_BOT_TOKEN', '')
    zabbix_api_url = os.environ.get('ZABBIX_API_URL', '')
    zabbix_api_login = os.environ.get('ZABBIX_API_USER', '')
    zabbix_api_pass = os.environ.get('ZABBIX_API_PASS', '')
    config_log_file = '/var/log/zabbix/znt.log'
    config_cache_file = '/var/cache/zabbix/cache.json'
    config_debug_mode = False
    config_verify_ssl = True
    config_zabbix_timeout = 30
    config_telegram_timeout = 10

# Configure SSL context based on config
if not config_verify_ssl:
    # Only disable SSL verification if explicitly configured to do so
    # This is a security risk and should not be used in production
    import warnings
    warnings.warn("SSL verification is disabled. This is a security risk.", Warning)
    ssl._create_default_https_context = ssl._create_unverified_context

# Configure logging
logger = logging.getLogger("znt")
logger.setLevel(logging.DEBUG if config_debug_mode else logging.INFO)

# Create formatter
formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')

# Add file handler if log file is configured
if config_log_file:
    try:
        file_handler = logging.FileHandler(filename=config_log_file, mode='a')
        file_handler.setLevel(logging.DEBUG if config_debug_mode else logging.INFO)
        file_handler.setFormatter(formatter)
        logger.addHandler(file_handler)
    except Exception as e:
        logger.error(f"Cannot write to log file {config_log_file}: {e}")

# Add console handler
console_handler = logging.StreamHandler()
console_handler.setLevel(logging.DEBUG if config_debug_mode else logging.INFO)
console_handler.setFormatter(formatter)
logger.addHandler(console_handler)

# Global variables
zbxApiUrl = zabbix_api_url
zbxApiUser = zabbix_api_login
zbxApiPass = zabbix_api_pass

tgProxy = tg_proxy
tgProxyServer = tg_proxy_server

# Telegram API URLs
tgApiUrl = "https://api.telegram.org/bot{token}/{method}"
tgApiSend = "https://api.telegram.org/bot{token}/sendMessage"
tgApiSendPhoto = "https://api.telegram.org/bot{token}/sendPhoto"
tgApiGetUpdates = "https://api.telegram.org/bot{token}/getUpdates"

# Zabbix API URLs
zbxApiLogin = "{url}/api_jsonrpc.php"
zbxApiMethod = "{url}/api_jsonrpc.php"

# Zabbix URLs
zbxUrl = zabbix_api_url.rstrip('/')

# Graph settings
zbxGraph = True
zbxGraphPeriodDefault = 3600
zbxGraphChart = "{zabbix_server}/chart3.php?name={name}&from=now-{range_time}&to=now&width=900&height=200&items[0][itemid]={itemid}&legend=1&showtriggers=1&showworkperiod=1"

# Messages format
body_messages = "<b>{subject}</b>{body}{links}{tags}{mentions}"
body_messages_max_symbol = 1200
body_messages_cut_symbol = True

body_messages_url_delimiter = " "
body_messages_url_template = "{icon} {url}"
body_messages_tags_delimiter = " "
body_messages_tags = True

body_messages_tags_event = True
body_messages_tags_eventid = True
body_messages_tags_itemid = True
body_messages_tags_triggerid = True
body_messages_tags_actionid = True
body_messages_tags_hostid = True

body_messages_tags_trigger_settings = True
body_messages_tags_prefix_eventid = "eid_"
body_messages_tags_prefix_itemid = "iid_"
body_messages_tags_prefix_triggerid = "tid_"
body_messages_tags_prefix_actionid = "aid_"
body_messages_tags_prefix_hostid = "hid_"
body_messages_tags_no = "#no_tags"
body_messages_tags_eventtag = True
body_messages_mentions_settings = True
body_messages_title = "{title} ({period_time})"

# Trigger settings tags
trigger_settings_tag = "ZNTSettings"
trigger_settings_tag_no_alert = "no_alert"
trigger_settings_tag_not_notify = "not_notify"
trigger_settings_tag_no_graph = "no_graph"
trigger_settings_tag_graph_period = "graphs_period"

# Trigger mentions tag
trigger_info_mentions_tag = "mentions"

# Zabbix links
zabbix_host_link = "{zabbix_server}/hostinventories.php?hostid={hostid}"
zabbix_graph_link = "{zabbix_server}/history.php?action=showgraph&itemids[]={itemid}&period={range_time}"
zabbix_event_link = "{zabbix_server}/tr_events.php?triggerid={triggerid}&eventid={eventid}"

# Status emoji mapping
zabbix_status_emoji_map = {
    "Problem": "🚨",
    "Resolved": "✅",
    "Update": "🚧",
    "Not classified": "⁉️",
    "Information": "💙",
    "Warning": "💛",
    "Average": "🧡",
    "High": "❤️",
    "Disaster": "💔",
    "Test": "🚽💩"
}

def validate_input(data):
    """Validate and sanitize input data"""
    if not data:
        return ""
    
    # Limit input size
    if len(str(data)) > 4096:
        logger.warning("Input data exceeds maximum size limit")
        return str(data)[:4096]
    
    # Basic sanitization
    sanitized = str(data).strip()
    return sanitized

def send_telegram_message(chat_id, message, photo=None):
    """Send message to Telegram chat"""
    try:
        if photo:
            url = tgApiSendPhoto.format(token=tg_token)
            data = {
                'chat_id': chat_id,
                'photo': photo,
                'caption': message,
                'parse_mode': 'HTML'
            }
        else:
            url = tgApiSend.format(token=tg_token)
            data = {
                'chat_id': chat_id,
                'text': message,
                'parse_mode': 'HTML'
            }
        
        # Convert data to JSON
        json_data = json.dumps(data).encode('utf-8')
        
        # Create request
        req = Request(url, data=json_data, headers={'Content-Type': 'application/json'})
        
        # Send request with timeout
        response = urlopen(req, timeout=config_telegram_timeout)
        result = response.read().decode('utf-8')
        
        logger.debug(f"Telegram response: {result}")
        return json.loads(result)
        
    except HTTPError as e:
        logger.error(f"HTTP error sending Telegram message: {e.code} - {e.reason}")
        return None
    except URLError as e:
        logger.error(f"URL error sending Telegram message: {e.reason}")
        return None
    except Exception as e:
        logger.error(f"Error sending Telegram message: {e}")
        return None

def get_zabbix_auth():
    """Authenticate with Zabbix API"""
    try:
        data = {
            "jsonrpc": "2.0",
            "method": "user.login",
            "params": {
                "user": zbxApiUser,
                "password": zbxApiPass
            },
            "id": 1
        }
        
        json_data = json.dumps(data).encode('utf-8')
        url = zbxApiLogin.format(url=zbxApiUrl)
        
        req = Request(url, data=json_data, headers={'Content-Type': 'application/json'})
        response = urlopen(req, timeout=config_zabbix_timeout)
        result = json.loads(response.read().decode('utf-8'))
        
        if 'result' in result:
            return result['result']
        else:
            logger.error(f"Zabbix authentication failed: {result}")
            return None
            
    except Exception as e:
        logger.error(f"Error authenticating with Zabbix API: {e}")
        return None

def get_zabbix_host_info(auth, hostid):
    """Get host information from Zabbix"""
    try:
        data = {
            "jsonrpc": "2.0",
            "method": "host.get",
            "params": {
                "output": ["hostid", "host", "name"],
                "selectInterfaces": ["ip"],
                "hostids": hostid
            },
            "auth": auth,
            "id": 1
        }
        
        json_data = json.dumps(data).encode('utf-8')
        url = zbxApiMethod.format(url=zbxApiUrl)
        
        req = Request(url, data=json_data, headers={'Content-Type': 'application/json'})
        response = urlopen(req, timeout=config_zabbix_timeout)
        result = json.loads(response.read().decode('utf-8'))
        
        if 'result' in result and result['result']:
            return result['result'][0]
        else:
            return None
            
    except Exception as e:
        logger.error(f"Error getting Zabbix host info: {e}")
        return None

def get_zabbix_item_info(auth, itemid):
    """Get item information from Zabbix"""
    try:
        data = {
            "jsonrpc": "2.0",
            "method": "item.get",
            "params": {
                "output": ["itemid", "name", "key_", "lastvalue", "units"],
                "itemids": itemid
            },
            "auth": auth,
            "id": 1
        }
        
        json_data = json.dumps(data).encode('utf-8')
        url = zbxApiMethod.format(url=zbxApiUrl)
        
        req = Request(url, data=json_data, headers={'Content-Type': 'application/json'})
        response = urlopen(req, timeout=config_zabbix_timeout)
        result = json.loads(response.read().decode('utf-8'))
        
        if 'result' in result and result['result']:
            return result['result'][0]
        else:
            return None
            
    except Exception as e:
        logger.error(f"Error getting Zabbix item info: {e}")
        return None

def generate_graph_url(itemid, period=zbxGraphPeriodDefault):
    """Generate URL for Zabbix graph"""
    try:
        # Validate inputs
        if not itemid or not str(itemid).isdigit():
            logger.warning("Invalid itemid for graph generation")
            return None
            
        period = int(period) if str(period).isdigit() else zbxGraphPeriodDefault
        
        # Generate graph URL
        graph_url = zbxGraphChart.format(
            zabbix_server=zbxUrl,
            name="Graph",
            range_time=period,
            itemid=itemid
        )
        
        logger.debug(f"Generated graph URL: {graph_url}")
        return graph_url
        
    except Exception as e:
        logger.error(f"Error generating graph URL: {e}")
        return None

def format_message(subject, message, event_data=None):
    """Format message for Telegram"""
    try:
        # Validate inputs
        subject = validate_input(subject)
        message = validate_input(message)
        
        # Escape HTML characters
        subject = escape(subject)
        message = escape(message)
        
        # Truncate message if too long
        if len(message) > body_messages_max_symbol and body_messages_cut_symbol:
            message = message[:body_messages_max_symbol] + "..."
        
        # Format message
        formatted_message = body_messages.format(
            subject=subject,
            body=message,
            links="",
            tags="",
            mentions=""
        )
        
        logger.debug(f"Formatted message: {formatted_message}")
        return formatted_message
        
    except Exception as e:
        logger.error(f"Error formatting message: {e}")
        return f"<b>{escape(subject)}</b>\n{escape(message)}"

def main():
    """Main function"""
    try:
        # Check arguments
        if len(sys.argv) < 4:
            logger.error("Usage: zbxTelegram.py <chat_id> <subject> <message>")
            sys.exit(1)
        
        # Get arguments
        chat_id = validate_input(sys.argv[1])
        subject = validate_input(sys.argv[2])
        message = validate_input(sys.argv[3])
        
        # Validate chat_id
        if not chat_id:
            logger.error("Chat ID is required")
            sys.exit(1)
        
        logger.info(f"Sending notification to chat {chat_id}")
        logger.debug(f"Subject: {subject}")
        logger.debug(f"Message: {message}")
        
        # Format message
        formatted_message = format_message(subject, message)
        
        # Send message to Telegram
        result = send_telegram_message(chat_id, formatted_message)
        
        if result and result.get('ok'):
            logger.info("Notification sent successfully")
            sys.exit(0)
        else:
            logger.error("Failed to send notification")
            sys.exit(1)
            
    except Exception as e:
        logger.error(f"Error in main function: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()