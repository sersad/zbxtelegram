#!/usr/lib/zabbix/alertscripts/venv/bin/python
# -*- coding: utf-8 -*-
########################

# Telegram
tg_token = "{{ zbxtelegram_bot_token }}"
tg_proxy = {{ zbxtelegram_proxy_enabled | default(false) | bool }}

{% if zbxtelegram_proxy_enabled | default(false) | bool %}
tg_proxy_server = "{{ zbxtelegram_proxy_url }}"
{% else %}
tg_proxy_server = None
{% endif %}

# Zabbix
zabbix_api_url = "{{ zbxtelegram_zabbix_url.rstrip('/') }}"
zabbix_api_login = "{{ zbxtelegram_zabbix_user }}"
zabbix_api_pass = "{{ zbxtelegram_zabbix_pass }}"

# Paths
config_log_file = "{{ zbxtelegram_log_dir }}/znt.log"
#### TODO: cache.json -> id.cache 
config_cache_file = "{{ zbxtelegram_cache_dir }}/cache.json"
config_debug_mode = {{ zbxtelegram_debug_enabled | default(false) | bool }}

config_exc_info = False

# Security Settings
config_verify_ssl = {{ zbxtelegram_verify_ssl | default(true) | bool }}
config_zabbix_timeout = {{ zbxtelegram_zabbix_timeout | default(30) }}
config_telegram_timeout = {{ zbxtelegram_telegram_timeout | default(10) }}
config_acknowledge_timeout = {{ zbxtelegram_acknowledge_timeout | default(180) }}

# Keyboard
zabbix_keyboard = {{ zbxtelegram_keyboard_enabled | default(true) | bool }}

zabbix_keyboard_row_width = 5

# Graphs
zabbix_graph = True
zabbix_graph_period_default = {{ zbxtelegram_graph_period_default | default(3600) }}
zabbix_graph_chart = "{zabbix_server}/chart3.php?name={name}&from=now-{range_time}&to=now&width=900&height=200&items[0][itemid]={itemid}&legend=1&showtriggers=1&showworkperiod=1"

# Watermark
watermark = {{ zbxtelegram_watermark_enabled | default(false) | bool }}

watermark_font = "{{ zbxtelegram_watermark_font | default('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf') }}"
watermark_label = "{{ zbxtelegram_watermark_label | default('Zabbix Notification') }}"
watermark_fill = 255
watermark_minimal_height = 30
watermark_rotate = 0
watermark_expand = True
watermark_text_color = (255, 0, 0, 128)


# Messages format
body_messages = "<b>{subject}</b>{body}{links}{tags}{mentions}"
body_messages_max_symbol = 1200
body_messages_cut_symbol = True

body_messages_url_delimiter = " "
body_messages_url_template = "{icon} {url}"
body_messages_tags_delimiter = " "
body_messages_tags = {{ zbxtelegram_tags | default(true) | bool }}

body_messages_tags_event = {{ zbxtelegram_tags_event | default(true) | bool }}

body_messages_tags_eventid = {{ zbxtelegram_tags_eventid | default(true) | bool }}

body_messages_tags_itemid = {{ zbxtelegram_tags_itemid | default(true) | bool }}

body_messages_tags_triggerid = {{ zbxtelegram_tags_triggerid | default(true) | bool }}

body_messages_tags_actionid = {{ zbxtelegram_tags_actionid | default(true) | bool }}

body_messages_tags_hostid = {{ zbxtelegram_tags_hostid | default(true) | bool }}

body_messages_tags_trigger_settings = True
body_messages_tags_prefix_eventid = "eid_"
body_messages_tags_prefix_itemid = "iid_"
body_messages_tags_prefix_triggerid = "tid_"
body_messages_tags_prefix_actionid = "aid_"
body_messages_tags_prefix_hostid = "hid_"
body_messages_tags_no = "#no_tags"
body_messages_tags_eventtag = True
body_messages_mentions_settings = True
body_messages_title = "{title} ({period_time})"

# Trigger settings tags
trigger_settings_tag = "ZNTSettings"
# TODO: добавить обработку таких тегов
trigger_settings_tag_no_alert = "no_alert"
trigger_settings_tag_not_notify = "not_notify"
trigger_settings_tag_no_graph = "no_graph"

trigger_settings_tag_graph_period = "graphs_period" # 'period='  # period=43200

# Trigger mentions tag
trigger_info_mentions_tag = "mentions"



# Zabbix links
# zabbix_host_link = "{zabbix_server}/zabbix.php?action=host.edit&hostid={hostid}"
# inventory
zabbix_host_link = "{zabbix_server}/hostinventories.php?hostid={hostid}"
zabbix_graph_link = "{zabbix_server}/history.php?action=showgraph&itemids[]={itemid}&period={range_time}"
zabbix_event_link = "{zabbix_server}/tr_events.php?triggerid={triggerid}&eventid={eventid}"

# TODO: У старого мапинга ключи другие
# старый мапинг
zabbix_status_emoji_map = {
    "Problem": "🚨",
    "Resolved": "✅",
    "Update": "🚧",
    "Not classified": "⁉️",
    "Information": "💙",
    "Warning": "💛",
    "Average": "🧡",
    "High": "❤️",
    "Disaster": "💔",
    "Test": "🚽💩"}

